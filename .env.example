# ==== AI 总结（必填才能生成总结） ====
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ==== 语音转写（可选）：无字幕视频自动下载音频并转写文稿 ====
# 智谱 GLM-ASR 示例：
# ASR_API_KEY=你的智谱Key
# ASR_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ASR_MODEL=glm-asr
# OpenAI Whisper 示例：
# ASR_API_KEY=你的OpenAIKey
# ASR_API_BASE=https://api.openai.com/v1
# ASR_MODEL=whisper-1

# ==== 可选 ====
# 输出目录（默认写入 Obsidian 路径）
# OUTPUT_DIR=
# 字幕语言匹配式（默认 zh.*,ai_.*,en.*）
# SUB_LANGS=zh.*,ai_.*,en.*
# Web 服务端口（默认 3000）
# PORT=3000
